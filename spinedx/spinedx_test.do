    gen `v'_9  = `v' if ver == 9
    gen `v'_10 = `v' if ver == 10
}
spinedx, dx9(d1_9 d2_9 d3_9) dx10(d1_10 d2_10 d3_10) idvar(id)
merge m:1 id using `expected', assert(match) nogenerate
foreach v in DEGDX SPINEDX1 SPINEDX2 SPINEDX3 SPINEDX4 SPINEDX5 SPINEDX6 SPINEDX7 SPINEDX8 SPINEDX9 SPINEDX10 SPINEDX11 SPINEDX12 SPINEDX13 SPINEDX14 SPINEDX15 SPINEDX16 REG_A REG_C REG_CT REG_T REG_TL REG_L REG_LS REG_S REG_M ANYSPINE {
    assert `v' == e_`v'
}
di as res "Separate-variable form matches."

di as res "All tests passed."
